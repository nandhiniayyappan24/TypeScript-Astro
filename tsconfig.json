{
  "extends": "./node_modules/astro/tsconfigs/strict",
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@/*": [
        "src/*"
      ]
    },
    "types": [
      "vitest/globals"
    ]
  },
  "include": [
    "src/**/*",
    "tests/**/*",
    "tools/TypeScriptAstro.Tools/**/*"
  ],
  "exclude": [
    "dist",
    "node_modules"
  ]
}
